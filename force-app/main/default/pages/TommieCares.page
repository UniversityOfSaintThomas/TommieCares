<apex:page id="TommieCares" controller="TommieCaresController" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" cache="false" docType="html-5.0">
    <apex:composition template="UndergradStThomas2023">
        <apex:define name="metaPageTitle">Tommie Cares</apex:define>

        <apex:define name="scriptsHead">
            <style>
                .formInputPadding {
                    padding: 0px 0px 15px 0px;
                    display: block;
                }

                .capricorn-main .slds-scope .required.slds-form-element__label, .capricorn-main .slds-scope .slds-form-element__label {
                    font-size: 1rem;
                }

                .tommieSelect td {
                    display: inline-block;
                    float: left;
                    padding: 5px;
                    margin: 5px;
                    border: solid 1px rebeccapurple;
                }

                .tommieSelect td input {
                    left: 45px;
                    top: -2px;
                    transform: translateX(-40px);
                }

                .tommieSelect td label {
                    padding: 3px 1px;
                    width: auto;
                }

                .messageTable {
                    color: #000;
                }
            </style>

            <script>
                function getMultiSelectValues(checkbox) {
                    let inputTable = checkbox.closest('table');
                    let result = [];
                    inputTable.querySelectorAll('input').forEach(inputValue => {
                        if (inputValue.checked) {
                            result.push(inputValue.value);
                        }
                    })
                    console.log(result.join(';'));
                    return result.join(';');
                }
            </script>
        </apex:define>

        <apex:define name="body">
            <apex:form>
                <apex:pageMessages/>

                <apex:actionFunction immediate="true" name="setPrimaryConcern" rerender="TommieCares">
                    <apex:param name="setPrimaryConcern" value="" assignTo="{!primaryConcern}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setHighFiveReason" rerender="TommieCares">
                    <apex:param name="setPrimaryConcern" value="" assignTo="{!highFiveReason}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setStudentCourse" rerender="TommieCares">
                    <apex:param name="stuC" value="" assignTo="{!courseOfferingId}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setCourseConnection" rerender="TommieCares">
                    <apex:param name="stuCC" value="" assignTo="{!studentCourseConnection}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setAcademicConcern" rerender="TommieCares">
                    <apex:param name="acconcs" value="" assignTo="{!academicConcern}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setAttendanceConcern" rerender="TommieCares">
                    <apex:param name="atconcs" value="" assignTo="{!attendanceConcern}"/>
                </apex:actionFunction>

                <apex:actionFunction immediate="true" name="setth5reason" rerender="TommieCares">
                    <apex:param name="setth5reason" value="" assignTo="{!highFiveReason}"/>
                </apex:actionFunction>

                <apex:outputPanel id="TommieCares" rendered="{!!courses.empty}" layout="none">

                    <apex:outputPanel style="block" id="introText" styleClass="formInputPadding">
                        <p class="slds-"><strong>Reporter Information: {!advisor.Name} ({!advisor.hed__UniversityEmail__c})</strong></p>
                        <p> If you have immediate concerns about the health or safety of a student, or for the St. Thomas community, please call Public Safety at 651-962-5555.</p>
                        <p> All concerns will be treated with discretion. Information from this form may be shared with appropriate individuals in order to provide additional support to a student.</p>
                    </apex:outputPanel>

                    <apex:outputPanel style="block" id="courseSelection" styleClass="formInputPadding slds-form-element">
                        <apex:outputLabel title="Please select the student's course:" value="Please select the student's course:" for="stuCourse" styleClass="slds-form-element__label"/>
                        <div class="slds-form-element__control">
                            <div class="slds-select_container">
                                <apex:selectList id="stuCourse" value="{!tommieCaresCase.Course_Offering__c}" required="true" multiselect="false" size="1" onChange="setStudentCourse(this.value);" styleClass="slds-select">
                                    <apex:SelectOptions value="{!Courses}"/>
                                </apex:selectList>
                            </div>
                        </div>
                    </apex:outputPanel>

                    <apex:outputPanel id="studentSelect" layout="block" rendered="{!studentsOptions.size > 1}" styleClass="formInputPadding slds-form-element">
                        <apex:outputLabel title="Please select the student of concern:" value="Please select the student of concern:" for="stucc" styleClass="slds-form-element__label"/>
                        <div class="slds-form-element__control">
                            <div class="slds-select_container">
                                <apex:selectList id="stucc" value="{!tommieCaresCase.ContactId}" required="true" multiselect="false" size="1" onChange="setCourseConnection(this.value);" styleClass="slds-select">
                                    <apex:SelectOptions value="{!studentsOptions}"/>
                                </apex:selectList>
                            </div>
                        </div>
                    </apex:outputPanel>

                    <!-- Set Primary Reason for alert-->
                    <apex:outputPanel id="primaryConcern" layout="block" rendered="{!!ISBLANK(studentCourseConnection)}" styleClass="formInputPadding slds-form-element">
                        <apex:outputLabel title="Please select the primary category of concern:"
                                          value="Please select the primary category of concern:"
                                          for="concerns"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:selectCheckboxes id="concerns" borderVisible="false" styleClass="tommieSelect" layout="lineDirection" onChange="setPrimaryConcern(getMultiSelectValues(this));">
                            <apex:SelectOptions value="{!primaryReasonOptions}"/>
                        </apex:selectCheckboxes>
                    </apex:outputPanel>


                    <!-- Set HIGH FIVE Reason-->
                    <apex:outputPanel id="tommieHigh5ReasonSelect" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Tommie High 5'),true,false)}">
                        <apex:outputLabel title="Please select Tommie High 5 Reason(s):"
                                          value="Please select Tommie High 5 Reason(s):" for="th5reasons"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:selectCheckboxes id="th5reasons" borderVisible="false" styleClass="tommieSelect" layout="lineDirection" required="true" onChange="setHighFiveReason(getMultiSelectValues(this))">
                            <apex:SelectOptions value="{!tommieHigh5ReasonOptions}"/>
                        </apex:selectCheckboxes>
                    </apex:outputPanel>

                    <!-- Add HIGH FIVE NOTE -->
                    <apex:outputPanel id="tommiehigh5Comment" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Tommie High 5'),true,false)}">
                        <apex:outputLabel title="Reporter: the student will receive an email with your message ex: You did a great job on your assignment. Keep working hard."
                                          value="Reporter: the student will receive an email with your message ex: You did a great job on your assignment. Keep working hard."
                                          styleClass="slds-form-element__label"
                                          for="tommiehigh5commentsL"/>
                        <apex:inputTextarea id="tommiehigh5commentsL" required="true" value="{!tommieCaresCase.Tommie_High_5_Notes__c}"/>
                    </apex:outputPanel>

                    <!-- Set Academic Performance Reason -->
                    <apex:outputPanel id="academicConcernSelect" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Academic performance concerns'),true,false)}">
                        <apex:outputLabel title="Please select academic concerns:"
                                          value="Please select academic concerns:" for="acconcerns"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:selectCheckboxes id="acconcerns" required="true" borderVisible="false" styleClass="tommieSelect" layout="lineDirection" onChange="setAcademicConcern(getMultiSelectValues(this));">
                            <apex:SelectOptions value="{!academicConcernOptions}"/>
                        </apex:selectCheckboxes>
                    </apex:outputPanel>

                    <!-- Set Attendance Concerns Reason -->
                    <apex:outputPanel id="attendanceConcernSelect" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Attendance concerns'),true,false)}">
                        <apex:outputLabel title="Please select attendance concerns:"
                                          value="Please select attendance concerns:" for="atconcerns"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:selectCheckboxes id="atconcerns" borderVisible="false" styleClass="tommieSelect" layout="lineDirection" onChange="setAttendanceConcern(getMultiSelectValues(this));">
                            <apex:SelectOptions value="{!attendanceConcernsOptions}"/>
                        </apex:selectCheckboxes>
                    </apex:outputPanel>

                    <!-- Set Will pass course YES/NO -->
                    <apex:outputPanel id="passClassSelect" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(((CONTAINS(primaryConcern,'Academic performance concerns')) || (CONTAINS(primaryConcern,'Attendance concerns'))),true,false)}">
                        <apex:outputLabel title="Can the student pass this course?"
                                          value="Can the student pass this course?" for="passclassconcerns"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:selectList id="passclassconcerns" value="{!tommieCaresCase.Can_this_student_pass_course__c}" required="true" multiselect="false">
                            <apex:selectOption itemValue="Yes"/>
                            <apex:selectOption itemValue="No"/>
                        </apex:selectList>
                    </apex:outputPanel>


                    <apex:outputPanel id="titleIXLink" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Relationship'),true,false)}">
                        <apex:outputLabel title="Please complete the Title IX Complaint form linked below after submitting this Tommie Cares form:"
                                          value="Please complete the Title IX Complaint form linked below after submitting this Tommie Cares form:"
                                          id="titIXConcernL"
                                          styleClass="slds-form-element__label"
                        />
                        <apex:outputLink value="https://stthomas-advocate.symplicity.com/titleix_report/index.php/pid350778?"
                                         target="_blank">Submit a Title IX Complaint | St. Thomas Conduct
                            (symplicity.com)
                        </apex:outputLink>
                    </apex:outputPanel>

                    <apex:outputPanel id="otherconcernComment" style="block" styleClass="formInputPadding slds-form-element" rendered="{!IF(CONTAINS(primaryConcern,'Other'),true,false)}">
                        <apex:outputLabel title="Please provide additional details about your Other concerns:"
                                          value="Please provide additional details about your Other concerns:"
                                          styleClass="slds-form-element__label"
                                          for="othercommentsL"/>
                        <apex:inputTextarea id="othercommentsL" required="true" value="{!tommieCaresCase.Tommie_Alert_Primary_Reason_Other_Notes__c}"/>
                    </apex:outputPanel>

                    <apex:outputPanel id="concernComment" style="block" styleClass="formInputPadding slds-form-element" rendered="{!!ISBLANK(primaryConcern)}">
                        <apex:outputLabel title="Please share any additional concerns or information related to this student that you would like the Tommie Success Team to know:"
                                          value="Please share any additional concerns or information related to this student that you would like the Tommie Success Team to know:"
                                          styleClass="slds-form-element__label"
                                          for="commentsL"/>
                        <apex:inputTextarea id="commentsL" value="{!tommieCaresCase.Shared_Case_Notes__c}"/>
                    </apex:outputPanel>


                    <apex:outputPanel id="saveCase" style="block" styleClass="formInputPadding" rendered="{!!ISBLANK(primaryConcern)}">
                        <div class="slds-p-vertical_medium">
                            <apex:commandButton action="{!saveCase}" styleClass="slds-button slds-button_brand" value="Save"/>
                        </div>
                    </apex:outputPanel>

                </apex:outputpanel>

                <p class="formInputPadding">To report a technical issue, please contact <a href="mailto:salesforce@stthomas.edu">salesforce@stthomas.edu</a>
                    or the ITS Tech Desk at (651) 962-6230.</p>

            </apex:form>
        </apex:define>
    </apex:composition>
</apex:page>