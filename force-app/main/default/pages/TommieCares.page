<apex:page id="TommieCares" controller="TommieCaresController" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" cache="false" docType="html-5.0">
    <apex:composition template="AdvisorAttendance">
        <apex:define name="afterJquery">

        </apex:define>
        <apex:define name="page-title">Tommie Cares</apex:define>

        <apex:define name="body">
            <style>
                .formInputPadding {
                    padding: 0px 0px 15px 0px;
                    display: block;
                }
            </style>
            <apex:pageblock >
                <apex:form >

                    <apex:actionFunction immediate="true" name="setStudentCourse" rerender="TommieCares">
                        <apex:param name="stuC" value="" assignTo="{!courseOfferingId}"/>
                    </apex:actionFunction>

                    <apex:actionFunction immediate="true" name="setCourseConnection" rerender="TommieCares">
                        <apex:param name="stuCC" value="" assignTo="{!studentCourseConnection}"/>
                    </apex:actionFunction>

                    <apex:actionFunction immediate="true" name="setPrimaryConcern" rerender="TommieCares">
                        <apex:param name="setPrimaryConcern" value="" assignTo="{!primaryConcern}"/>
                    </apex:actionFunction>

                    <apex:actionFunction immediate="true" name="setacconcs" rerender="TommieCares">
                        <apex:param name="acconcs" value="" assignTo="{!academicConcern}"/>
                    </apex:actionFunction>

                    <apex:actionFunction immediate="true" name="setatconcs" rerender="TommieCares">
                        <apex:param name="atconcs" value="" assignTo="{!attendanceConcern}"/>
                    </apex:actionFunction>


                    <apex:outputPanel id="TommieCares" rendered="{!!courses.empty}">

                        <apex:outputPanel style="block" id="introText" styleClass="formInputPadding">
                            <p><strong>Reporter Information: {!advisor.Name} ({!advisor.hed__UniversityEmail__c})</strong></p>
                            <p> If you have immediate concerns about the health or safety of a student, or for the St. Thomas community, please call Public Safety at 651-962-5555.</p>
                            <p> All reports will be treated with discretion. Information from this form may be shared with appropriate individuals in order to provide additional support to a student.</p>
                        </apex:outputPanel>

                        <apex:outputPanel style="block" id="courseSelection" styleClass="formInputPadding">
                            <apex:outputLabel title="Please select the student's course:"
                                              value="Please select the student's course:" id="stuCourseL"/>
                            <apex:selectList id="stuCourse" value="{!tommieCaresCase.Course_Offering__c}" required="true" multiselect="false" size="1" onChange="setStudentCourse(this.value);">
                                <apex:SelectOptions value="{!Courses}"/>
                            </apex:selectList>
                        </apex:outputPanel>

                        <apex:outputPanel id="studentSelect" layout="block" rendered="{!students.size > 1}" styleClass="formInputPadding">
                            <apex:outputLabel title="Please select the student of concern:" value="Please select the student of concern:" id="stuNameL"/>
                            <apex:selectList id="stucc" value="{!tommieCaresCase.Course_Connection__c}" required="true" multiselect="false" size="1" onChange="setCourseConnection(this.value);">
                                <apex:SelectOptions value="{!students}"/>
                            </apex:selectList>
                        </apex:outputPanel>

                        <apex:outputPanel id="primaryConcern" layout="block" rendered="{!!ISBLANK(studentCourseConnection)}" styleClass="formInputPadding">
                            <apex:outputLabel title="Please select the primary category of concern:"
                                              value="Please select the primary category of concern:"
                                              id="catConcernL"/>

<!--                            <c:MultiselectPicklist leftLabel="" leftOption="{!primaryReason}" rightLabel="" rightOption="{!primaryConcern}" showUpDownButtons="false" size="14" width="304px"/>-->

                            <apex:selectList id="concerns" value="{!tommieCaresCase.Tommie_Alert_Primary_Reason__c}" required="true" multiselect="true" size="4" onChange="setPrimaryConcern(getMultiSelectValues(this));">
                                <apex:SelectOptions value="{!primaryReason}"/>
                            </apex:selectList>
                        </apex:outputPanel>

                        <apex:outputPanel id="academicConcernSelect" style="block" styleClass="formInputPadding" rendered="{!IF(CONTAINS(primaryConcern,'Academic concerns'),true,false)}">
                            <apex:outputLabel title="Please select academic concerns:"
                                              value="Please select academic concerns:" id="acConcernL"/>
                            <apex:selectList id="acconcerns" value="{!tommieCaresCase.Academic_Performance_Reason_s__c}" required="true" multiselect="true" size="3" onChange="setacconcs(this.value);">
                                <apex:SelectOptions value="{!academicConcerns}"/>
                            </apex:selectList>
                        </apex:outputPanel>


                        <apex:outputPanel id="attendanceConcernSelect" style="block" styleClass="formInputPadding" rendered="{!IF(CONTAINS(primaryConcern,'Attendance concerns'),true,false)}">
                            <apex:outputLabel title="Please select attendance concerns:"
                                              value="Please select attendance concerns:" id="atConcernL"/>
                            <apex:selectList id="atconcerns" value="{!tommieCaresCase.Attendance_Concerns_Reason_s__c}" required="true" multiselect="true" size="3" onChange="setatconcs(this.value);">
                                <apex:SelectOptions value="{!attendanceConcerns}"/>
                            </apex:selectList>
                        </apex:outputPanel>

                        <apex:outputPanel id="titleIXLink" style="block" styleClass="formInputPadding" rendered="{!IF(CONTAINS(primaryConcern,'Relationship'),true,false)}">
                            <apex:outputLabel title="Please complete the Title IX Complaint form linked below after submitting this Tommie Cares form:"
                                              value="Please complete the Title IX Complaint form linked below after submitting this Tommie Cares form:"
                                              id="titIXConcernL"/>
                            <apex:outputLink value="https://stthomas-advocate.symplicity.com/titleix_report/index.php/pid350778?"
                                             target="_blank">Submit a Title IX Complaint | St. Thomas Conduct
                                (symplicity.com)
                            </apex:outputLink>
                        </apex:outputPanel>

                        <apex:outputPanel id="concernComment" style="block" styleClass="formInputPadding" rendered="{!!ISBLANK(primaryConcern)}">
                            <apex:outputLabel title="Please share any additional concerns or information related to this student that you would like the university to know:"
                                              value="Please share any additional concerns or information related to this student that you would like the university to know:"
                                              id="commentsL"/>
                            <apex:inputTextarea value="{!tommieCaresCase.Shared_Case_Notes__c}"/>
                        </apex:outputPanel>

                    </apex:outputpanel>
                    <p></p>
                    <p>To report a technical issue, please contact <a href="mailto:salesforce@stthomas.edu">salesforce@stthomas.edu</a>
                        or the ITS Tech Desk at (651) 962-6230.</p>
                </apex:form>
            </apex:pageblock>

            <script>
                function getMultiSelectValues(select) {
                    let result = [];
                    let options = select && select.options;
                    let opt;

                    for (let i = 0, iLen = options.length; i < iLen; i++) {
                        opt = options[i];

                        if (opt.selected) {
                            result.push(opt.value || opt.text);
                        }
                    }
                    return result.join(';');
                }
            </script>
        </apex:define>
    </apex:composition>
</apex:page>